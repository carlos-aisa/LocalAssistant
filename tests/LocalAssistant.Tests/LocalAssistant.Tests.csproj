  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalAssistant.Api\LocalAssistant.Api.csproj" />
    <ProjectReference Include="..\..\src\LocalAssistant.Core\LocalAssistant.Core.csproj" />
